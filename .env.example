# Copy this file to .env and fill in what you have. .env is never committed (see .gitignore).
# Every cloud key is optional; providers without a key are skipped. Order and models live in config.toml.

GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Control centre: set a passcode to open it from your phone on your home Wi-Fi (leave empty = this computer only)
WEBAPP_PASSCODE=
# WEBAPP_PORT=8765

# Optional overrides
# GEMINI_MODEL=gemini-flash-latest
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
